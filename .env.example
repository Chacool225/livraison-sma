# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=livraison
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=livraison
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ---
# Si un port est déjà pris sur votre machine, changez-le ici (POSTGRES_PORT, REDIS_PORT)
# et gardez REDIS_URL cohérent. « 127.0.0.1 » est plus rapide que « localhost » sous Windows.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- Serveur XMPP (SPADE) ---
XMPP_HOST=localhost
XMPP_PORT=5222
XMPP_DOMAINE=localhost
XMPP_MOT_DE_PASSE_AGENTS=changez-moi

# --- Moteur d'itinéraires ---
OSRM_URL=http://localhost:5000

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
JWT_DUREE_HEURES=12

# --- Comptes (authentification par téléphone) ---
# "dev" : le code de vérification est renvoyé par l'API (pas de vrai SMS). Mettre "production" ensuite.
ENVIRONNEMENT=dev
INDICATIF_PAYS_DEFAUT=+225
